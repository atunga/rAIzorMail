{
  "name": "raizormail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A calmer Gmail and Google Calendar desktop for Mac.",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && electron-builder --mac dir && node scripts/sign.mjs",
    "installer": "npm run package && node scripts/installer.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/sansita": "^5.2.6",
    "dompurify": "^3.2.7",
    "html-to-text": "^10.0.1",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.16",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.6.0",
    "electron-builder": "26.15.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "ai.raizorcrest.mail",
    "productName": "rAIzorMail",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "dmg": {
      "title": "rAIzorMail",
      "artifactName": "rAIzorMail-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "identity": null,
      "icon": "build/icon.icns"
    }
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "author": "rAIzor crest",
  "license": "UNLICENSED"
}
